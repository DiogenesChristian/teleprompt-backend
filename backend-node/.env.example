# Copie este arquivo para .env e preencha.

# Porta do backend
PORT=4000

# MongoDB. Deixe vazio para usar o banco em memória salvo em data/dev-db.json
# (bom para desenvolver e apresentar sem instalar o MongoDB).
# Exemplos: mongodb://localhost:27017/globoflow  ou a URL do MongoDB Atlas
MONGODB_URI=

# Segredo usado para assinar os tokens de login. Troque por um texto longo e aleatório.
JWT_SECRET=troque-este-segredo

# Código que a pessoa precisa digitar para criar conta de Jornalista / Editor
# (o único perfil que aprova roteiros). Vazio = qualquer um pode criar.
EDITOR_CODE=

# Endereços do frontend liberados (CORS), separados por vírgula. * = todos.
CORS_ORIGIN=*

# Serviço de IA em Python (revisão do roteiro)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=8000

# Deepgram — API pública de reconhecimento de fala em tempo real (pt-BR).
# Crie a chave grátis em https://console.deepgram.com (vem com crédito inicial).
# Vazio = o teleprompter usa o reconhecimento de fala do próprio navegador.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=pt-BR

# Edição com o roteiro NO AR (alguma tela apresentando).
# Funções que podem alterar o texto, separadas por vírgula. * = qualquer usuário logado.
LIVE_EDIT_ROLES=Jornalista / Editor,Produtor
# O que acontece com a aprovação quando o texto muda durante o ao vivo:
#   manter-se-editor → continua aprovado se quem editou é Jornalista / Editor (padrão)
#   revisao          → qualquer mudança volta para "Em revisão"
#   manter           → continua aprovado
LIVE_EDIT_APPROVAL=manter-se-editor
